[Unit]
Description=Chatty low-bandwidth RP broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chatty
Group=chatty
WorkingDirectory=/var/lib/chatty
ExecStart=/usr/local/bin/chatty-broker
Environment=CHATTY_DATABASE=sqlite:///var/lib/chatty/chatty.db?mode=rwc
Environment=CHATTY_CERT=/etc/chatty/server.pem
Environment=CHATTY_KEY=/etc/chatty/server.key
Environment=CHATTY_LLAMA_URL=http://192.168.0.97:11434/v1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chatty
MemoryMax=256M

[Install]
WantedBy=multi-user.target
