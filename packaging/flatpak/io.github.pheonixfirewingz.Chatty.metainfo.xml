<component type="desktop-application">
  <id>io.github.pheonixfirewingz.Chatty</id>
  <name>Chatty</name>
  <summary>Chat with persistent AI characters</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.pheonixfirewingz">
    <name>pheonixfirewingz</name>
