  <update_contact>pheonixfirewingz@users.noreply.github.com</update_contact>
  <url type="homepage">https://github.com/pheonixfirewingz/Chatty</url>
  <url type="bugtracker">https://github.com/pheonixfirewingz/Chatty/issues</url>
  <url type="vcs-browser">https://github.com/pheonixfirewingz/Chatty</url>
  <description>
    <p>
      Chatty is a native desktop client for persistent AI character roleplay.
      It connects securely to a separately operated Chatty broker, keeping your
      conversations and character state in sync across sessions.
    </p>
    <p>
      The client is built with Rust and egui, runs entirely on your machine,
      and communicates with the broker over an encrypted TLS connection.
    </p>
  </description>
  <launchable type="desktop-id">io.github.pheonixfirewingz.Chatty.desktop</launchable>
  <categories>
    <category>Network</category>
    <category>Utility</category>
  </categories>
  <provides>
    <binary>chatty-gui</binary>
  </provides>
