{
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "{{model}}"}},
  "2": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["1", 1]}},
  "3": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{negative_prompt}}", "clip": ["1", 1]}},
  "4": {"class_type": "EmptyLatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
  "5": {"class_type": "SDTurboScheduler", "inputs": {"model": ["1", 0], "steps": "{{steps}}", "denoise": 1.0}},
  "6": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler_ancestral"}},
  "7": {"class_type": "SamplerCustom", "inputs": {
    "model": ["1", 0], "add_noise": true, "noise_seed": "{{seed}}", "cfg": "{{guidance}}",
    "positive": ["2", 0], "negative": ["3", 0], "sampler": ["6", 0], "sigmas": ["5", 0],
    "latent_image": ["4", 0]
  }},
  "8": {"class_type": "VAEDecode", "inputs": {"samples": ["7", 0], "vae": ["1", 2]}},
  "9": {"class_type": "PreviewImage", "inputs": {"images": ["8", 0]}}
}
